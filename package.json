{
  "name": "llm-meter",
  "version": "0.1.0",
  "description": "Zero-config cost and latency tracker for OpenAI API calls",
  "author": "TU_NOMBRE",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "openai",
    "llm",
    "cost",
    "tokens",
    "observability"
  ],
  "peerDependencies": {
    "openai": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "dotenv": "^17.4.1",
    "openai": "^6.33.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}